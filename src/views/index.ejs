<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>60秒读懂世界</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="container">
    <header>
      <h1>每日60秒读懂世界</h1>
      <p class="subtitle">每天6点更新，一分钟了解天下事</p>
    </header>
    
    <main id="news-container">
      <div class="loading">
        <div class="spinner"></div>
        <p>加载中...</p>
      </div>
    </main>
    
    <footer>
      <p>&copy; 2025 60秒读懂世界 - 新闻聚合平台</p>
    </footer>
  </div>
  
  <template id="news-template">
    <div class="news-card">
      <div class="date-container">
        <div class="date"></div>
      </div>
      
      <div class="news-header">
        <img class="header-image" src="" alt="每日头图">
      </div>
      
      <div class="news-content">
        <div class="news-image-container">
          <img class="news-image" src="" alt="每日新闻图">
        </div>
        
        <div class="news-list-container">
          <ul class="news-list"></ul>
        </div>
        
        <div class="weiyu-container">
          <p class="weiyu"></p>
        </div>
        
        <div class="audio-container">
          <div class="audio-controls">
            <button id="play-btn" class="play-btn">播放新闻</button>
            <div class="volume-container">
              <input type="range" id="volume" min="0" max="1" step="0.1" value="0.5">
              <span class="volume-icon">🔊</span>
            </div>
          </div>
          <audio id="news-audio" src=""></audio>
          <audio id="bg-music" loop></audio>
        </div>
      </div>
    </div>
  </template>
  
  <script src="/js/main.js"></script>
</body>
</html> 